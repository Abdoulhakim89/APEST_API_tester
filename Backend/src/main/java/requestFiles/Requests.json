{
  "baseUrl": "https://dummyjson.com",
  "tests": [

    {
      "name": "Get all products returns 200",
      "type": "status",
      "method": "GET",
      "endpoint": "/products",
      "headers": null,
      "body": null,
      "assertions": [
        { "assertion": "status", "expected": 200 },
        { "assertion": "body_has_property", "expected": "products" }
      ]
    },

    {
      "name": "Get single product contains title",
      "type": "status",
      "method": "GET",
      "endpoint": "/products/1",
      "headers": null,
      "body": null,
      "assertions": [
        { "assertion": "status", "expected": 200 },
        { "assertion": "body_has_property", "expected": "title" }
      ]
    },

    {
      "name": "Search product returns results",
      "type": "status",
      "method": "GET",
      "endpoint": "/products/search?q=phone",
      "headers": null,
      "body": null,
      "assertions": [
        { "assertion": "status", "expected": 200 },
        { "assertion": "body_has_property", "expected": "products" }
      ]
    },

    {
      "name": "Create product successfully",
      "type": "status",
      "method": "POST",
      "endpoint": "/products/add",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "title": "APEST Product",
        "price": 99
      },
      "assertions": [
        { "assertion": "status", "expected": 201 },
        {
          "assertion": "has_property_value",
          "expected": {
            "property": "title",
            "value": "APEST Product"
          }
        }
      ]
    },

    {
      "name": "Login user returns token",
      "type": "status",
      "method": "POST",
      "endpoint": "/user/login",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "username": "emilys",
        "password": "emilyspass"
      },
      "assertions": [
        { "assertion": "status", "expected": 200 },
        { "assertion": "body_has_property", "expected": "accessToken" }
      ]
    },

    {
      "name": "Update product title",
      "type": "status",
      "method": "PUT",
      "endpoint": "/products/1",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "title": "Updated by APEST"
      },
      "assertions": [
        { "assertion": "status", "expected": 200 },
        {
          "assertion": "has_property_value",
          "expected": {
            "property": "title",
            "value": "Updated by APEST"
          }
        }
      ]
    },

    {
      "name": "Delete product works",
      "type": "status",
      "method": "DELETE",
      "endpoint": "/products/1",
      "headers": null,
      "body": null,
      "assertions": [
        { "assertion": "status", "expected": 200 },
        {
          "assertion": "has_property_value",
          "expected": {
            "property": "isDeleted",
            "value": true
          }
        }
      ]
    }

  ]
}